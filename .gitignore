node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Build & Outputs ---
dist/
dist-ssr/
build/
out/
.next/
admin/.next/
admin/out/
admin/build/
.tsbuildinfo
*.tsbuildinfo

# --- Project Specific ---
output/
backend/output/
backend/docs/assets/temp/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Environment & Secrets ---
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
.vercel
admin/.vercel

# --- Testing ---
coverage/
.nyc_output/

# --- IDE & Editors ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- OS Specific ---
.DS_Store
.DS_Store?
._*
Thumbs.db

# --- Tools ---
.cache/
.puppeteer/
next-env.d.ts
admin/next-env.d.ts

# --- Private Documentation ---
