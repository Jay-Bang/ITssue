# ==========================================
# ITssue Environment Variables Template
# ==========================================

# 1. Supabase & Database
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_service_role_key

# 2. AI Engine (Gemini)
# Add multiple keys for rotation (optional)
CLOUD_AI_KEY_1=your_api_key_1
CLOUD_AI_MODEL=gemini-flash-latest

# 3. Instagram & Telegram Automation
IG_USER_ID=your_instagram_user_id
IG_ACCESS_TOKEN=your_facebook_access_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# 4. Admin & Webhook
WEBHOOK_PORT=3000
ADMIN_API_KEY=your_secure_admin_api_key
