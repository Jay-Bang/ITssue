# ITssue-AI Environment Variables Example

# 1. Supabase Settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# 2. Google AI (Gemini) - Supports Multi-Key Rotation
# You can provide multiple keys separated by commas, or index them as CLOUD_AI_KEY_1, ...
CLOUD_AI_KEY=key1,key2
CLOUD_AI_MODEL=gemini-2.0-flash-exp

# 3. Instagram Graph API
# Required for --publish mode
IG_USER_ID=your_instagram_business_account_id
IG_ACCESS_TOKEN=your_long_lived_user_access_token

# 4. Telegram Notification (Optional)
# Get token from @BotFather and Chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
